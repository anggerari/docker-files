{
  "realm": "dev",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "sslRequired": "none",
  "users": [
    {
      "username": "dev",
      "email": "dev@example.com",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "dev", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "app",
      "name": "Local app (public, for SPAs / mobile)",
      "enabled": true,
      "publicClient": true,
