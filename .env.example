# Copy to .env and edit:  cp .env.example .env   (or run: make init)
# Docker Compose reads .env automatically.

# Which services to start (comma-separated profiles, or * for everything):
#   postgres, redis, s3, nsq, mongo, mail, qr,
#   kafka, rabbitmq, search, keycloak, observability
COMPOSE_PROFILES=postgres,redis

# 127.0.0.1 = only this machine. 0.0.0.0 = your whole network (change passwords first!)
BIND_ADDR=127.0.0.1
TZ=UTC

# PostgreSQL + pgAdmin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Redis + RedisInsight
REDIS_PASSWORD=redis
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb          # low-memory mode: 64mb
REDISINSIGHT_PORT=5540

# RustFS (S3-compatible)
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# NSQ
NSQADMIN_PORT=4171
# Address nsqd advertises to clients. 127.0.0.1 works for apps on your host;
# use "nsqd" if your app runs inside this compose network.
NSQ_BROADCAST_ADDRESS=127.0.0.1

# MongoDB + mongo-express
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_PORT=27017
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
MONGO_EXPRESS_PORT=8081
MONGO_CACHE_GB=0.25             # low-memory mode: 0.1

# Mailpit (SMTP catcher). Point your app's SMTP at localhost:1025, any user/pass.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=5000

# QR generator
QR_PORT=9010

# Kafka (KRaft) + Redpanda Console
KAFKA_PORT=9092
KAFKA_CONSOLE_PORT=8088
KAFKA_HEAP=512m                # low-memory mode: 256m
KAFKA_RETENTION_HOURS=24       # delete old messages so the disk doesn't fill up

# RabbitMQ
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=rabbit
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Elasticsearch + Kibana
ES_PORT=9200
ES_HEAP=512m                   # low-memory mode: 256m
KIBANA_PORT=5601
KIBANA_HEAP_MB=768             # low-memory mode: 512

# Keycloak - realm "dev", user dev/dev, clients "app" (public) and "api" (secret api-secret)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_HEAP=512m             # low-memory mode: 256m

# Observability: Grafana + Prometheus + Loki + Alloy
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=3d
LOKI_PORT=3100
ALLOY_PORT=12345
